[Unit]
Description=Automatic Jabra busylight (on while the microphone is in use)
Documentation=https://github.com/julien-langlois/jabra-busylight-linux
After=pipewire-pulse.service pulseaudio.service
Wants=pipewire-pulse.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/jabra-busylight/config
ExecStart=%h/.local/bin/jabra-busylight daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
